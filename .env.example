# ============ MySQL ============
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=reportdb
MYSQL_USER=appuser
MYSQL_PASSWORD=change_me_user

# ============ Redis ============
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ============ RabbitMQ ============
CELERY_BROKER=amqp://appuser:apppass@rabbitmq:5672//
CELERY_BACKEND=redis://redis:6379/1

# ============ JWT ============
JWT_SECRET_KEY=change_me_to_a_random_32_bytes_secret_key

# ============ AES ============
AES_KEY=0123456789abcdef0123456789abcdef
AES_IV=abcdef9876543210

# ============ 文件存储 ============
REPORT_DIR=/app/reports